{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Ejecutar Archivo Actual",
      "skipFiles": ["<node_internals>/**"],
      "program": "${file}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Ejecutar Index",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/scripts/index.js",
      "cwd": "${workspaceFolder}"
    }
  ]
}
